{{!
    Template: local_learningoutcomes/tag_activity_panel
    Renders the inline tagging panel for a single activity.

    The panel is a <details> element whose <summary> colour-codes the nudge state:
      - no class         : initial state before JS applies colour
      - lo-state-untagged   : amber warning — needs at least one outcome
      - lo-state-tagged     : green check — at least one outcome tagged
      - lo-state-decorative : grey — teacher marked this as informational

    Context variables:
      cmid            {number}   Course module ID.
      courseid        {number}   Course ID.
      outcomes        {array}    Array of {id, shortname, fullname, tagged} objects.
      isdecorative    {boolean}  Whether the teacher has marked this CM as decorative.
      taglabel        {string}   Localised "Link to learning outcomes" label.
      savelabel       {string}   Localised "Save changes" label.
      decorativelabel {string}   Localised "Decorative/informational activity" label.

    @template  local_learningoutcomes/tag_activity_panel
    @copyright 2026 Moodle Pty Ltd
    @license   https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<details class="lo-tag-details border rounded p-2 mt-1 small" data-lo-cmid="{{cmid}}">
    <summary class="fw-semibold text-muted">
        {{taglabel}}
    </summary>
    <div class="lo-tag-panel__body pt-2">
        {{#outcomes}}
        <div class="form-check">
            <input
                class="form-check-input"
                type="checkbox"
                id="lo-outcome-{{../cmid}}-{{id}}"
                data-outcomeid="{{id}}"
                {{#tagged}}checked{{/tagged}}
            >
            <label class="form-check-label" for="lo-outcome-{{../cmid}}-{{id}}">
                <span class="fw-semibold">{{shortname}}</span> — {{fullname}}
            </label>
        </div>
        {{/outcomes}}
        {{^outcomes}}
        <p class="text-muted fst-italic mb-1">{{nooutcomeslabel}}</p>
        {{/outcomes}}
        <div class="form-check mt-2">
            <input
                class="form-check-input"
                type="checkbox"
                id="lo-decorative-{{cmid}}"
                data-decorative="1"
                {{#isdecorative}}checked{{/isdecorative}}
            >
            <label class="form-check-label text-muted" for="lo-decorative-{{cmid}}">
                {{decorativelabel}}
            </label>
        </div>
        <button
            type="button"
            class="btn btn-sm btn-primary mt-2"
            data-action="lo-save"
            data-cmid="{{cmid}}"
            data-courseid="{{courseid}}"
        >
            {{savelabel}}
        </button>
    </div>
</details>
